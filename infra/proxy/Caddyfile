# OpsPilot TLS reverse-proxy reference (Caddy).
#
# Terminates TLS 1.2/1.3 for the Web UI and Hub API and upgrades WebSocket traffic for the
# agent control socket at /api/agents/connect (wss://). Hub, Worker and Postgres stay on the
# internal Compose network; only this proxy is published. See compose.tls.yaml.
#
# Usage:
#   1. Put your certificate and key at infra/proxy/certs/fullchain.pem and privkey.pem
#      (or use a DNS-validated certificate via a Caddy DNS module, or Caddy's automatic
#      Let's Encrypt when the name is public).
#   2. Set OPSPILOT_DOMAIN in .env, e.g. OPSPILOT_DOMAIN=ops.example.com
#   3. docker compose -f compose.yaml -f compose.tls.yaml --profile full up -d

{
	# Never negotiate below TLS 1.2.
	 servers :443 {
		 protocols tls1.2 tls1.3
	 }
}

{$OPSPILOT_DOMAIN:localhost} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

	# Trust nothing from clients; forward the real peer for Hub-side auditing.
	@agent_ws path /api/agents/connect
	handle @agent_ws {
		reverse_proxy hub:3001 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.remote.host}
			# WebSocket upgrade headers are forwarded by Caddy automatically for
			# upgraded connections; set them explicitly for clarity.
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	# Hub API (used by agents for enroll/install) is proxied through the web origin path
	# /api/* which the Next.js rewrite forwards to hub:3001; ensure Upgrade/Connection are
	# preserved for any websocket under /api/.
	handle /api/* {
		reverse_proxy web:3000 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.remote.host}
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
		}
	}

	log {
		output file /var/log/caddy/opspilot-access.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}
