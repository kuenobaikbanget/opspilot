# Deploy in /etc/opspilot/agent.env with chmod 0600
OPSPILOT_HUB_URL=https://opspilot.example.com
OPSPILOT_ENROLL_TOKEN=
OPSPILOT_ALLOWED_SERVICES=nginx,docker,sshd
OPSPILOT_CONFIG_FILES=/etc/nginx/nginx.conf
OPSPILOT_INTERVAL_SECONDS=15
OPSPILOT_ENABLE_DOCKER=false
# Optional: exactly one locally allowlisted systemd .service unit (empty disables).
OPSPILOT_SYSTEMD_UNIT=
