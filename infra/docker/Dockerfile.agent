FROM golang:1.23-alpine AS build
WORKDIR /src
COPY agent/go.mod ./
RUN go mod download
COPY agent/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /opspilot-agent ./cmd/opspilot-agent
FROM alpine:3.21
RUN apk add --no-cache ca-certificates iproute2 && mkdir -p /data && chown 10001:10001 /data
COPY --from=build /opspilot-agent /usr/local/bin/opspilot-agent
USER 10001:10001
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/opspilot-agent"]
