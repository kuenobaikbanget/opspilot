# Local development only. Do not reuse these credentials on public servers.
DATABASE_URL=postgres://opspilot:opspilot_dev@localhost:5433/opspilot
PORT=3001
HUB_INTERNAL_URL=http://localhost:3001
# Optional dashboard curl onboarding; leave blank until a reviewed release containing `enroll` is published.
# Explicit target-reachable HTTPS origin only; never inferred from browser/internal URLs.
OPSPILOT_PUBLIC_HUB_URL=
# Exact published vMAJOR.MINOR.PATCH tag (optional SemVer prerelease; no latest/build metadata).
OPSPILOT_AGENT_VERSION=
# Optional GitHub owner/repository override; default shown. Not a download URL.
OPSPILOT_AGENT_REPOSITORY=kuenobaikbanget/opspilot
# Set ADMIN_PASSWORD_HASH to Argon2 hash generated by bun run password:hash -- "your-password"
ADMIN_PASSWORD_HASH=
# For localhost bootstrap ONLY; NEVER use in deployment. Remove after generating hash.
ADMIN_PASSWORD=change-this-local-password
# Local development only: set to true to bypass admin login when NODE_ENV!=production (refused in production).
DISABLE_AUTH=false
SESSION_SECRET=replace-with-at-least-32-random-characters-please
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:3000
ALERT_CPU_THRESHOLD=95
ALERT_MEMORY_THRESHOLD=90
ALERT_DISK_THRESHOLD=90
INVESTIGATION_POLL_MS=3000
# Generate once with: openssl rand -base64 32
# Share the same value with Hub and Worker only; back it up separately from the database.
# Without this key, monitoring works but AI provider mutations/execution are unavailable.
AI_PROVIDER_ENCRYPTION_KEY=
