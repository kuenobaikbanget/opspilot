# Local development only. Do not reuse these credentials on public servers.
DATABASE_URL=postgres://opspilot:opspilot_dev@localhost:5433/opspilot
PORT=3001
HUB_INTERNAL_URL=http://localhost:3001
# Optional dashboard curl onboarding; leave blank unless using a reviewed compatible release.
# Remote installs require an explicit HTTPS origin. Never inferred from browser/internal URLs.
OPSPILOT_PUBLIC_HUB_URL=
# Exact published vMAJOR.MINOR.PATCH tag (optional SemVer prerelease; no latest/build metadata).
OPSPILOT_AGENT_VERSION=
# Optional GitHub owner/repository override; default shown. Not a download URL.
OPSPILOT_AGENT_REPOSITORY=kuenobaikbanget/opspilot
# Same-machine foreground onboarding only: requires NODE_ENV=development and a raw
# http://127.0.0.1:<PORT> OPSPILOT_PUBLIC_HUB_URL matching the bound Hub port.
OPSPILOT_DEV_LOOPBACK_INSTALL=false
# Set ADMIN_PASSWORD_HASH to Argon2 hash generated by bun run password:hash -- "your-password"
ADMIN_PASSWORD_HASH=
# For localhost bootstrap ONLY; NEVER use in deployment. Remove after generating hash.
ADMIN_PASSWORD=change-this-local-password
# Local development only: set to true to bypass admin login when NODE_ENV!=production (refused in production).
DISABLE_AUTH=false
SESSION_SECRET=replace-with-at-least-32-random-characters-please
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:3000
ALERT_CPU_THRESHOLD=95
ALERT_MEMORY_THRESHOLD=90
ALERT_DISK_THRESHOLD=90

# Alert cooldown after a threshold breach before the condition can return to ok (seconds).
ALERT_COOLDOWN_SECONDS=900
# Metric retention applied by the worker: raw samples roll up hourly and are deleted
# after this many hours; hourly rollups are deleted after this many days.
METRIC_RAW_RETENTION_HOURS=168
METRIC_ROLLUP_RETENTION_DAYS=90
# Agent-side durable telemetry queue bounds while the Hub is unreachable. The queue file
# defaults beside the agent identity (OPSPILOT_QUEUE_PATH) with mode 0600; oldest samples
# are dropped first once a cap is hit.
# OPSPILOT_QUEUE_PATH=
# OPSPILOT_QUEUE_MAX_ENTRIES=2000
# OPSPILOT_QUEUE_MAX_AGE_SECONDS=86400
INVESTIGATION_POLL_MS=3000
# Local development only: allow endpoint probes to localhost/127.0.0.1 mock endpoints when NODE_ENV!=production.
OPSPILOT_ALLOW_LOOPBACK_PROBES=false
# Generate once with: openssl rand -base64 32
# Share the same value with Hub and Worker only; back it up separately from the database.
# Without this key, monitoring works but AI provider mutations/execution are unavailable.
AI_PROVIDER_ENCRYPTION_KEY=
