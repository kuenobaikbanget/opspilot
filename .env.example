# Local development only. Do not reuse these credentials on public servers.
DATABASE_URL=postgres://opspilot:opspilot_dev@localhost:5433/opspilot
PORT=3001
HUB_INTERNAL_URL=http://localhost:3001
# Set ADMIN_PASSWORD_HASH to Argon2 hash generated by bun run password:hash -- "your-password"
ADMIN_PASSWORD_HASH=
# For localhost bootstrap ONLY; NEVER use in deployment. Remove after generating hash.
ADMIN_PASSWORD=change-this-local-password
SESSION_SECRET=replace-with-at-least-32-random-characters-please
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:3000
ALERT_CPU_THRESHOLD=95
ALERT_MEMORY_THRESHOLD=90
ALERT_DISK_THRESHOLD=90
INVESTIGATION_POLL_MS=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
